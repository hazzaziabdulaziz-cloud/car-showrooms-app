rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'hazzazi.abdulaziz@gmail.com';
    }
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /cars/{showroomId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    match /showroom_docs/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    match /towing_handovers/{orderId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImage();
    }
  }
}
