rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'hazzazi.abdulaziz@gmail.com';
    }

    match /showrooms/{showroomId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
    }

    match /cars/{carId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
    }

    match /tow_drivers/{driverId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
    }

    match /inspectors/{inspectorId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid) || resource.data.is_verified == true;
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAdmin() || request.auth != null;
      allow delete: if isAdmin();
    }

    match /buyer_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || request.auth != null;
    }
  }
}
