rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === الإحصائيات والتتبع ===
    match /analytics_summary/{docId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if false;
    }
    match /analytics_daily/{docId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if false;
    }
    match /analytics_events/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // === أكواد الخصم والكوبونات ===
    match /discount_codes/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // === الفواتير وسيستم الحسابات ===
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    match /ledger_entries/{entryId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null;
    }

    // === سجل الأخطاء المعزولة ===
    match /app_error_logs/{logId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false;
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'hazzazi.abdulaziz@gmail.com'
      );
    }

    // المستخدمون: كل مستخدم يقرأ ويعدل ملفه فقط
    match /users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // المعارض والسيارات: القراءة متاحة للجميع، والتعديل لمالك المعرض أو المدير فقط
    match /showrooms/{showroomId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    match /cars/{carId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    // الطلبات: المشتري يقرأ طلباته فقط، ولا يُسمح بتغيير المبالغ أو حالة الدفع من الجوال
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyer_uid == request.auth.uid ||
        resource.data.showroom_owner_uid == request.auth.uid ||
        resource.data.inspector_uid == request.auth.uid ||
        resource.data.tow_uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.buyer_uid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'deposit_paid', 'platform_fee', 'inspector_payout_status', 'car_price'
        ])
      );
      allow delete: if isAdmin();
    }

    // النزاعات والتقييمات
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.buyer_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyer_uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyer_uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // الفاحصون وكباتن السطحة
    match /inspectors/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /tow_drivers/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
